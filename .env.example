# WanderIA - Environment Variables
# Copy this file to .env.local and fill in the values

# Database Configuration
DATABASE_PATH=./data/wanderia.db

# JWT Secret (IMPORTANT: Change this in production!)
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-change-in-production

# Ollama AI Configuration (Optional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Node Environment
NODE_ENV=development

# Optional: Skyscanner Affiliate Partner ID (for flight referral links)
# Register at https://partners.skyscanner.net/ to get your ID
# SKYSCANNER_PARTNER_ID=your-partner-id
